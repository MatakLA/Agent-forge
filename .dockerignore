# The demo image is built from the repository root. Keep everything private, local
# or bulky out of the build context, so an image can never contain it.
.git
.github
.dockerignore

# secrets and per-install configuration
.env
.env.*
*.key
*.token
*.keyring
secrets/
.secrets/
etc/foreman.conf
etc/limits.conf
etc/forge.conf
etc/workers.conf
etc/team-rules.md
etc/lessons.md
egress/allowlist.local.txt
egress/local-endpoint.conf

# runtime state, logs, per-install projects
runs/
audit/
projects/
state/
*.log
*.sid
ALERT

# benchmark work trees and results
bench/.work/
bench/results/raw/

# caches and editor files
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.idea/
.vscode/
*.swp
*~
.DS_Store
