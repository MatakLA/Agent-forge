#!/usr/bin/env bash
# ==============================================================================
# Universal Agent Runner for Sandbox Worker Containers
# Supports Gemini (Antigravity), Claude (Claude Code), and OpenAI / ChatGPT.
# ==============================================================================
set -euo pipefail

PROVIDER="${AGENT_PROVIDER:-auto}"
MODEL="${AGENT_MODEL:-}"
PW_FILE="${KEYRING_PW_FILE:-/run/secrets/keyring}"

# Initialize private D-Bus session and gnome-keyring if needed for CLI token storage
if [ -z "${AGENT_RUN_INNER:-}" ]; then
  if [ -r "$PW_FILE" ]; then
    export AGENT_RUN_INNER=1
    exec dbus-run-session -- "$0" "$@"
  fi
fi

if [ -n "${KEYRING_PW_FILE:-}" ] && [ -r "$PW_FILE" ]; then
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/xdg-$(id -u)}"
  mkdir -p "$XDG_RUNTIME_DIR" "$HOME/.local/share/keyrings"
  chmod 700 "$XDG_RUNTIME_DIR"
  tr -d '\n' < "$PW_FILE" | gnome-keyring-daemon --daemonize --login --components=secrets >/dev/null 2>&1 || true
  gnome-keyring-daemon --start --components=secrets >/dev/null 2>&1 || true
fi

# Auto-detect provider if set to auto
if [ "$PROVIDER" = "auto" ]; then
  if [ -n "${OPENAI_API_KEY:-}" ] || [ -f "/run/secrets/openai-token" ]; then
    PROVIDER="openai"
  elif [ -n "${ANTHROPIC_API_KEY:-}" ] || command -v claude >/dev/null 2>&1; then
    PROVIDER="claude"
  else
    PROVIDER="gemini"
  fi
fi

# Dispatch to configured agent provider
case "$PROVIDER" in
  gemini)
    exec /usr/local/bin/agy-run ${MODEL:+--model "$MODEL"} "$@"
    ;;

  claude)
    if command -v claude >/dev/null 2>&1; then
      exec claude "$@"
    else
      # Fallback to agy with Claude model
      exec /usr/local/bin/agy-run --model "${MODEL:-claude-sonnet-4-6}" "$@"
    fi
    ;;

  openai|chatgpt)
    if command -v aider >/dev/null 2>&1; then
      exec aider "$@"
    else
      # Fallback to agy with OpenAI model
      exec /usr/local/bin/agy-run --model "${MODEL:-gpt-4o}" "$@"
    fi
    ;;

  *)
    # Default fallback to agy
    exec /usr/local/bin/agy-run "$@"
    ;;
esac
