#!/bin/bash
# Git credential helper: serves the worker's Forgejo token, only for the internal Forgejo host.
# Invariants:
# - Receives token via secrets file, never as a CLI argument in argv.
# - Suppresses shell tracing (xtrace/verbose) so tokens are never logged on stderr.
# - Tolerates debug/verbose flags (-v, --verbose) without failing or logging the token.
set +x 2>/dev/null
set +v 2>/dev/null

action=""
for arg in "$@"; do
  case "$arg" in
    -v|--verbose|-d|--debug) ;;
    get) action="get" ;;
    *) ;; # ignore any extra arguments; token is NEVER accepted via argv
  esac
done

[ "$action" = "get" ] || exit 0

host=""
while IFS='=' read -r k v; do [ -z "$k" ] && break; [ "$k" = "host" ] && host="$v"; done
[ "$host" = "forgejo:3000" ] || exit 0

TOKEN_FILE="${FORGEJO_TOKEN_FILE:-/run/secrets/forgejo-token}"
[ -f "$TOKEN_FILE" ] || exit 0

echo "username=${FORGEJO_USER:-worker-1}"
printf 'password=%s\n' "$(< "$TOKEN_FILE")"

