#!/bin/bash
# Git credential helper: serves the worker's Forgejo token, only for the internal Forgejo host.
[ "${1:-}" = "get" ] || exit 0
host=""
while IFS='=' read -r k v; do [ -z "$k" ] && break; [ "$k" = "host" ] && host="$v"; done
[ "$host" = "forgejo:3000" ] || exit 0
echo "username=${FORGEJO_USER:-worker-1}"
echo "password=$(tr -d '\n' < /run/secrets/forgejo-token)"
