# ==============================================================================
# Agent-Forge Environment Template (.env)
# Copy to .env or place tokens in ~/.config/sandbox/secrets/
# ==============================================================================

# ------------------------------------------------------------------------------
# API Keys (Optional if using headless subscription CLIs like agy / claude code)
# ------------------------------------------------------------------------------
# Anthropic API Key for Claude Orchestrator / Worker
ANTHROPIC_API_KEY=

# OpenAI API Key for ChatGPT / GPT-4o Orchestrator / Worker
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# Google Gemini API Key
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Git Forge Configuration
# ------------------------------------------------------------------------------
FORGEJO_HOST=127.0.0.1
FORGEJO_HTTP_PORT=3000
FORGEJO_SSH_PORT=2222
FORGEJO_ORG=sandbox
FORGEJO_REPO=playground

# Orchestrator & Monitoring Bot Tokens
FORGEJO_MONITOR_TOKEN=
FORGEJO_ORCHESTRATOR_TOKEN=

# ------------------------------------------------------------------------------
# Worker Configuration
# ------------------------------------------------------------------------------
WORKER_COUNT=4
WORKER_CPUS=1.5
WORKER_MEM=2g
WORKER_MODEL=gemini-3.8-flash-high
