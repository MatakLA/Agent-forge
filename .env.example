# ==============================================================================
# Agent-Forge Environment Configuration (.env)
# ==============================================================================

# Dashboard Web UI
DASHBOARD_BIND_IP=127.0.0.1
DASHBOARD_PORT=8171
DASHBOARD_HOSTS=localhost,127.0.0.1
DASHBOARD_TOKEN=
DEMO_MODE=0

# Internal Forgejo Git Service
FORGE_CONTAINER=agent-forge-forgejo
FORGE_HTTP_PORT=3000
FORGE_SSH_PORT=2222

# Egress Proxy Service
EGRESS_CONTAINER=agent-forge-egress-proxy
EGRESS_MODE=enforce
