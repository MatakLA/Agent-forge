#!/usr/bin/env python3
"""Usage: bin/review-branch <branch> [--diff] [--mutations SPEC.json]
Read-only review of a worker branch (fetch with the read-only monitoring token, nothing is pushed or merged):
  1. commits + diffstat + name-status; warns about deleted/renamed files, non-worker authors, merge commits, secret-like strings
  2. scans test files for skip/xfail/assert True and test functions without any assertion
  3. measured quality findings (QUALITY_CHECK): test/code ratio, files outside the task's list (env GATE_ALLOWED_FILES), weakened tests,
     copied helper functions, new unused imports, unwired and oversized files
  4. runs the tests in a fresh container (no network, read-only source, all caps dropped, 1 CPU / 1 GB, non-root): first the changed test
     files and their neighbours (a red one ends the gate at once - minutes saved), then the whole suite
  5. --mutations: SPEC.json = [{"name":..., "file":"pkg/cli.py", "old":"exact text", "new":"replacement"}, ...]; each mutant must make the tests fail
  6. --diff prints the full diff
Prints "== FLAGS: a,b" (the kinds of warnings) just before the warnings list.
Exit: 0 clean, 1 warnings or surviving mutants (review by hand), 2 tests fail / fetch failed, 3 the gate itself broke (no verdict - never a pass)."""
import ast, json, os, re, shutil, subprocess, sys, tempfile, traceback


def _broke(kind, exc, tb):
    # Python ends an uncaught exception with exit 1, the same as "warnings" - which the foreman lets through. A gate that breaks gives no verdict.
    try:
        sys.stdout.flush()
        print(f"\n== GATE ERROR: the gate itself broke ({kind.__name__}: {str(exc)[:200]}) - no verdict, NOT a pass".encode("utf-8", "replace").decode(), flush=True)
        traceback.print_exception(kind, exc, tb)
        sys.stderr.flush()
    finally:
        os._exit(3)


sys.excepthook = _broke
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib"))
import sbx, quality
a = sys.argv[1:]
if not a or a[0].startswith("-"):
    print(__doc__); sys.exit(2)
branch = a[0]
spec = json.load(open(a[a.index("--mutations") + 1])) if "--mutations" in a else []
IMAGE = sbx.gate_image()                 # the project's GATE_IMAGE (default: the worker image, Python + pytest)
TEST_CMD = sbx.test_cmd()
SECRET_PATTERNS = ((r"sk-ant-[A-Za-z0-9_-]{20,}", "an Anthropic API key"), (r"\bsk-(proj-|svcacct-)?[A-Za-z0-9_-]{32,}", "an OpenAI API key"),
                   (r"AIza[0-9A-Za-z_-]{30,}|ya29\.[0-9A-Za-z_-]{20,}", "a Google API key / token"),
                   (r"\bgh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,}", "a GitHub token"), (r"\bglpat-[A-Za-z0-9_-]{20,}", "a GitLab token"),
                   (r"\bAKIA[0-9A-Z]{16}\b", "an AWS access key"), (r"\bxox[baprs]-[A-Za-z0-9-]{10,}", "a Slack token"),
                   (r"BEGIN [A-Z ]*PRIVATE KEY", "a private key"))                # the project's TEST_CMD (default: python3 -m pytest -q -p no:cacheprovider)
tok = open(os.path.join(sbx.SECRETS, "monitor.token")).read().strip()
tmp = tempfile.mkdtemp(prefix="review-")
warn, flags = [], []


def W(flag, text):
    warn.append(text)
    if flag not in flags:
        flags.append(flag)


def sh(*c, cwd=None, timeout=300):
    # a diff or a test's output can hold bytes that are not UTF-8 (a Latin-1 CSV): they are shown as U+FFFD, never a crash
    return subprocess.run(list(c), capture_output=True, encoding="utf-8", errors="replace", cwd=cwd, timeout=timeout)


# the token goes to git through the environment, never argv (argv is world-readable in /proc/*/cmdline)
os.environ.update(GIT_CONFIG_COUNT="1", GIT_CONFIG_KEY_0="http.extraHeader", GIT_CONFIG_VALUE_0=f"Authorization: token {tok}")


def git(*c):
    return sh("git", *c, cwd=repo)


try:
    repo = os.path.join(tmp, "repo")
    r = sh("git", "clone", "-q", f"{sbx.FORGE_URL}/{sbx.FORGE_REPO}.git", repo)
    if r.returncode or git("fetch", "-q", "origin", branch).returncode:
        print("could not fetch the branch from Forgejo:", r.stderr.strip()[:200]); sys.exit(2)
    sh("git", "checkout", "-q", "origin/" + branch, cwd=repo)
    base = "origin/main"
    print(f"== review of {branch} against main")
    print(sh("git", "log", "--format=%h %an  %s", f"{base}..HEAD", cwd=repo).stdout.rstrip())
    for l in sh("git", "log", "--format=%an|%p", f"{base}..HEAD", cwd=repo).stdout.splitlines():
        who, parents = l.split("|")
        if not re.fullmatch(r"worker-\d+", who):
            W("author", f"commit author is not a worker bot: {who}")
        if len(parents.split()) > 1:
            W("merge-commit", "branch contains a merge commit")
    print("\n" + sh("git", "diff", "--stat", f"{base}...HEAD", cwd=repo).stdout.rstrip())
    ns = sh("git", "diff", "--name-status", f"{base}...HEAD", cwd=repo).stdout.splitlines()
    print("\nname-status: " + ", ".join(ns))
    for l in ns:
        st, path = l.split("\t", 1)[0], l.split("\t")[-1]
        if st[:1] in ("D", "R", "C"):               # a plain edit of an existing file is normal (reuse beats copying); removal and moves are not
            W("deleted-or-moved", f"file deleted/renamed/copied: {l}")
        if path.startswith(".") and path not in (".gitignore",):
            W("dot-file", f"dot-file touched: {path}")
    changed = [(l.split("\t", 1)[0], l.split("\t")[-1]) for l in ns]
    added = sh("git", "diff", "--unified=0", f"{base}...HEAD", cwd=repo).stdout
    plus = [x for x in added.splitlines() if x.startswith("+") and not x.startswith("+++")]
    if any(re.search(r"\b[0-9a-f]{40}\b", x) for x in plus):
        W("token-like", "added lines contain a 40-hex string (token-like)")
    # real secrets are a hard stop, not a warning: API keys of the worker runtimes, forge tokens, cloud keys, private keys
    secrets = [what for pat, what in SECRET_PATTERNS if any(re.search(pat, x) for x in plus)]
    if secrets:
        print("\n== SECRET: the branch adds " + ", ".join(secrets) + " - refused. Remove it from the branch's history.")
    # test-quality scan
    tests = [p.split("\t")[-1] for p in ns if p[:1] != "D" and re.search(r"(^|/)test_.*\.py$", p.split("\t")[-1])]      # a deleted test file has nothing to scan
    ntests = 0
    for t in tests:
        try:
            with open(os.path.join(repo, t), errors="replace") as fh:
                src = fh.read()
        except OSError as e:
            W("unreadable", f"{t}: cannot be read ({type(e).__name__})")
            continue
        for pat in (r"pytest\.mark\.skip", r"pytest\.skip\(", r"xfail", r"importorskip", r"assert True\b", r"skipif"):
            if re.search(pat, src):
                W("skip-marker", f"{t}: contains '{pat}'")
        try:
            tree = ast.parse(src)
        except (SyntaxError, ValueError) as e:
            W("unparsable", f"{t}: is not valid Python ({type(e).__name__}) - the test run shows the error")
            continue
        for node in ast.walk(tree):
            if isinstance(node, ast.FunctionDef) and node.name.startswith("test_"):
                ntests += 1
                has = any(isinstance(n, (ast.Assert,)) or (isinstance(n, ast.Call) and getattr(n.func, "attr", "") in ("raises", "fail")) for n in ast.walk(node))
                if not has:
                    W("no-assertion", f"{t}::{node.name} has no assertion")
    # documentation: every new module says what it is for (the code map and the workers' context packs are built from it)
    for l in ns:
        st, path = l.split("\t", 1)[0], l.split("\t")[-1]
        if st.startswith("A") and path.endswith(".py") and not re.search(r"(^|/)(test_[^/]*|conftest)\.py$", path):
            try:
                if not ast.get_docstring(ast.parse(open(os.path.join(repo, path), errors="replace").read())):
                    W("no-docstring", f"{path}: new module without a module docstring (purpose, interface, invariants)")
            except (OSError, SyntaxError, ValueError):
                pass
    # test economy and wiring (QUALITY_CHECK=off|warn|block, TEST_RATIO_MAX lines of tests per line of code)
    pc = sbx.project_conf()
    qmode = pc.get("QUALITY_CHECK", "warn")
    quality_msg = ""
    if qmode != "off":
        try:
            ratio_max = float(pc.get("TEST_RATIO_MAX", "1.5"))
        except ValueError:
            ratio_max = 1.5
        t_add, c_add = quality.test_ratio(sh("git", "diff", "--numstat", f"{base}...HEAD", cwd=repo).stdout.splitlines())
        print(f"\nlines added: code {c_add}, tests {t_add}" + (f" (ratio {t_add / c_add:.1f}, limit {ratio_max})" if c_add else ""))
        quality_msg = quality.ratio_message(t_add, c_add, ratio_max)
        added_src = [l.split("\t")[-1] for l in ns if l.startswith("A")]
        loose = quality.unreferenced(repo, added_src)
        if loose:
            W("unwired", "new source file(s) that no other file refers to yet (fine only if a later task of this goal wires them in): " + ", ".join(loose[:8]))
        grown = [l.split("\t")[-1] for l in ns if l[:1] in "AM"]
        big = quality.oversized(repo, grown, int(pc.get("MAX_FILE_LINES", "400") or 400))
        if big:
            W("big-file", "big source file(s) - a worker has to re-read them every time; split into modules: " + ", ".join(f"{p} ({n} lines)" for p, n in big[:6]))
        # facts a script can see, so the reviewer does not have to find them (the same checks run in the worker's self-check)
        allowed = [f.strip() for f in os.environ.get("GATE_ALLOWED_FILES", "").split(",") if f.strip()]
        shared = [x.strip() for x in str(pc.get("SHARED_FILES", "")).split(",") if x.strip()]
        out = quality.outside_scope(changed, allowed, shared)
        if out:
            W("scope", "scope: files changed that are not in the task's file list: " + ", ".join(out[:8]) + (" ..." if len(out) > 8 else ""))
        for tp, ra, aa, rt, at in quality.weakened_tests(added)[:5]:
            W("weakened", f"weakened: {tp} lost assertions/tests (assertions {ra} removed / {aa} added, test functions {rt} removed / {at} added)")
        mb = sh("git", "merge-base", base, "HEAD", cwd=repo).stdout.strip() or base
        for dp, dn, dq, dk in quality.duplicate_defs(repo, [c for c in changed if c[0][:1] in ("A", "M")], base=mb)[:6]:
            W("duplicate", f"duplicate: {dp} defines `{dn}` ({dk} lines), a copy of the one in {dq} - import it instead")
        shown = 0
        for st, up in changed:
            if st[:1] in ("A", "M") and up.endswith(".py") and shown < 6:
                try:
                    with open(os.path.join(repo, up), errors="ignore") as fh:
                        un = quality.unused_imports(fh.read(400000), sh("git", "show", f"{mb}:{up}", cwd=repo).stdout if st[:1] == "M" else None)
                except OSError:
                    continue
                if un:
                    shown += 1
                    W("unused-import", f"unused-import: {up} imports {', '.join(un)} and never uses it")
        if quality_msg:
            print("\n== QUALITY: " + quality_msg)
            if qmode != "block":
                W("ratio", "QUALITY: " + quality_msg)
    print(f"\ntest files: {tests or 'none'}, test functions: {ntests}")
    if not tests:
        W("no-test-file", "no test file in the diff")
    dock = ["docker", "run", "--rm", "--network", "none", "--read-only", "--tmpfs", "/tmp:rw,exec,size=256m", "--cap-drop", "ALL",
            "--security-opt", "no-new-privileges", "--memory", "1g", "--cpus", "1", "--pids-limit", "256", "-e", "PYTHONDONTWRITEBYTECODE=1"]
    def drun(*args, timeout):
        # killing the docker client on a timeout does NOT stop the container (--rm only fires when it exits): name it and remove it
        name = f"{os.path.basename(tmp)}-{os.urandom(3).hex()}"
        try:
            return sh(*dock, "--name", name, *args, timeout=timeout)
        except subprocess.TimeoutExpired:
            sh("docker", "rm", "-f", name, timeout=60)
            raise

    gate_timeout = int(os.environ.get("GATE_TIMEOUT", "1500"))
    # fast pass: the changed test files and their neighbours first. A red one is the common failure and shows within seconds; the whole suite
    # (minutes, one CPU) runs only when this is green. Skipped for any test command that is not a plain pytest call.
    t, fast_red = None, False
    ftargets = quality.test_targets(repo, changed) if sbx.is_pytest(TEST_CMD) and quality.fast_pytest_cmd(TEST_CMD) and os.environ.get("GATE_FAST", "1") != "0" else []
    if ftargets:
        try:
            f = drun("-e", "HOME=/tmp", "-v", f"{repo}:/src:ro", "-w", "/src", "--entrypoint", "sh", IMAGE, "-c",
                     TEST_CMD + " --maxfail=5 " + " ".join(ftargets), timeout=min(600, gate_timeout))
            if f.returncode not in (0, 5, 125, 126, 127):
                t, fast_red = f, True
            print(f"\n== fast pass, {len(ftargets)} changed/related test file(s): " + ((f.stdout + f.stderr).strip().splitlines() or ["(no output)"])[-1])
        except subprocess.TimeoutExpired:
            print(f"\n== fast pass, {len(ftargets)} test file(s): timed out - running the whole suite")
    if t is None:
        try:
            t = drun("-e", "HOME=/tmp", "-v", f"{repo}:/src:ro", "-w", "/src", "--entrypoint", "sh", IMAGE, "-c", TEST_CMD, timeout=gate_timeout)
        except subprocess.TimeoutExpired:
            # not caught, this ended the gate with exit 1 (= warnings) and the branch went on to the review untested
            t = subprocess.CompletedProcess([], 124, "", f"TIMEOUT: the test suite did not finish within {gate_timeout} s (GATE_TIMEOUT) - a test hangs or the suite is too slow")
    print(f"\n== {'whole suite NOT run (fast pass is red)' if fast_red else 'full test suite'} in a fresh container (`{TEST_CMD}`): "
          + ((t.stdout + t.stderr).strip().splitlines() or ["(no output)"])[-1])
    fail = t.returncode != 0 or bool(secrets) or (bool(quality_msg) and qmode == "block")
    if fail and t.returncode == 0 and not secrets:
        print("== QUALITY-ONLY: the tests pass; the branch is refused for the quality finding above")
    if fail and t.returncode == 5 and sbx.is_pytest(TEST_CMD) and not tests:
        fail = False                     # pytest found no tests at all: a branch without code tests (docs, design) is not red
        W("no-tests-yet", "the repository has no tests yet")
    if re.search(r"\b(skipped|xfailed|xpassed)\b", t.stdout.strip().splitlines()[-1] if t.stdout.strip() else ""):
        W("skipped-tests", "test run reports skipped/xfailed tests: " + t.stdout.strip().splitlines()[-1])
    if fail:
        print(t.stdout[-1500:], t.stderr[-500:])
    surv = 0
    if spec and not fail:
        runner = os.path.join(tmp, "mutate.py")
        open(runner, "w").write('''import json, os, shutil, subprocess, sys
spec = json.load(open("/spec.json"))
for m in spec:
    try:        # one mutant that cannot be set up (file gone, latin-1 source, bad entry) is reported as ERROR, it must not hide the rest
        shutil.rmtree("/tmp/m", ignore_errors=True); shutil.copytree("/src", "/tmp/m", ignore_dangling_symlinks=True)
        p = os.path.join("/tmp/m", m["file"]); s = open(p, errors="surrogateescape").read()      # surrogateescape: any bytes survive the round trip
        if m["old"] not in s:
            print(json.dumps(dict(name=m["name"], result="BAD-SPEC", note="pattern not found"))); continue
        open(p, "w", errors="surrogateescape").write(s.replace(m["old"], m["new"], 1))
        cmd = os.environ["TEST_CMD"] + (" -x" if "pytest" in os.environ["TEST_CMD"] else "")     # stop at the first failure
        r = subprocess.run(["sh", "-c", cmd], cwd="/tmp/m", capture_output=True, text=True, errors="replace")
        print(json.dumps(dict(name=m["name"], result="KILLED" if r.returncode else "SURVIVED", tail=r.stdout.strip().splitlines()[-1] if r.stdout.strip() else "")))
    except Exception as e:
        print(json.dumps(dict(name=m.get("name", "?") if isinstance(m, dict) else "?", result="ERROR", note=(type(e).__name__ + ": " + str(e))[:160])))
''')
        json.dump(spec, open(os.path.join(tmp, "spec.json"), "w"))
        try:
            m = drun("-e", "HOME=/tmp", "-e", f"TEST_CMD={TEST_CMD}", "-v", f"{repo}:/src:ro", "-v", f"{runner}:/mutate.py:ro",
                     "-v", f"{os.path.join(tmp, 'spec.json')}:/spec.json:ro", "--entrypoint", "python3", IMAGE, "/mutate.py", timeout=900)
        except subprocess.TimeoutExpired:
            m = subprocess.CompletedProcess([], 124, "", "the mutation check did not finish within 900 s")
        print(f"\n== mutation check ({len(spec)} mutants)")
        seen = 0
        for l in m.stdout.splitlines():
            try:
                d = json.loads(l)
                line = f"  {d['result']:9} {d['name']}  {d.get('tail', d.get('note', ''))}"
            except Exception:
                continue
            seen += 1
            print(line)
            if d["result"] != "KILLED":
                surv += 1
        if not seen:
            W("mutants", f"the mutation check gave no result (exit {m.returncode}): {(m.stderr.strip().splitlines() or ['no output'])[-1][:160]} - not verified")
        elif seen < len(spec):
            W("mutants", f"the mutation check stopped after {seen} of {len(spec)} mutants (exit {m.returncode}): {(m.stderr.strip().splitlines() or ['no output'])[-1][:160]} - the rest is not verified")
        if surv:
            W("mutants", f"{surv} mutant(s) survived or had a bad spec - check whether they are equivalent")
    if "--diff" in a:
        print("\n== diff\n" + sh("git", "diff", f"{base}...HEAD", cwd=repo).stdout)
    if flags:
        print("\n== FLAGS: " + ",".join(flags))
    print("\n== warnings: " + ("none" if not warn else ""))
    for w in warn:
        print("  ! " + w)
    sys.exit(2 if fail else (1 if warn else 0))
finally:
    shutil.rmtree(tmp, ignore_errors=True)
