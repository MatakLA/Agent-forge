#!/usr/bin/env python3
"""Poll GitHub or GitLab for open issues labelled agent-forge and queue each as a foreman goal.

Public interface:
  bin/issues-intake [--project NAME] [--label LABEL] [--dry-run]
  intake_issues(kind=..., repo=..., token=..., project=..., label=..., dry_run=...)
  validate_issue(issue)

Invariants:
  - Stdlib-only (Python 3 urllib.request, subprocess, json, re, argparse).
  - Only polls issues with the specified label (default: agent-forge).
  - Validates polled issues and rejects malformed JSON, missing fields, invalid types, control/NUL characters, and oversized input cleanly without tracebacks.
  - Queues each issue exactly once by persisting seen issue IDs in issues-intake.json.
  - Passes goal text strictly over stdin to bin/foreman goal -, never in argv.
  - Never logs or exposes tokens; passes credentials solely in Authorization header.
  - Exits 0 on success; 1 on auth, network, configuration, or payload validation errors.
"""
import argparse
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
REPO_RE = re.compile(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+')
PROJECT_RE = re.compile(r'[a-z0-9][a-z0-9-]{0,39}')
HTML_TAG_RE = re.compile(r'<[^>]+>')
CONTROL_CHARS_RE = re.compile(r'[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]')
MAX_TITLE_LEN = 10000

LABEL_TO_ROLE = {
    "bug": "tester",
    "docs": "technical-writer",
    "security": "security-tester",
    "feature": "backend-developer",
}


def get_issue_role(issue):
    """Determine foreman role based on issue labels matching LABEL_TO_ROLE mapping."""
    labels = issue.get("labels") or []
    for lbl in labels:
        name = lbl if isinstance(lbl, str) else (lbl.get("name") or lbl.get("title") or "")
        if name in LABEL_TO_ROLE:
            return LABEL_TO_ROLE[name]
    return None


def load_kv(path):
    """Load key-value pairs from a config file using sbx.py's parsing pattern."""
    out = {}
    try:
        with open(path, "r", encoding="utf-8") as f:
            for line in f:
                line = line.split("#", 1)[0].strip()
                if "=" in line:
                    k, v = (x.strip() for x in line.split("=", 1))
                    out[k] = v.strip('"').strip("'")
    except OSError:
        pass
    return out


def strip_html(text):
    """Strip HTML tags using simple regex <[^>]+> -> ''."""
    return HTML_TAG_RE.sub("", text)


def build_goal(title, body):
    """Build a goal string "{title}\n\n{body}" truncated to 4000 chars with HTML stripped."""
    clean_title = strip_html(title or "").strip()
    clean_body = strip_html(body or "").strip()
    goal = f"{clean_title}\n\n{clean_body}".strip() if clean_body else clean_title
    return goal[:4000]


def get_config(project=None):
    """Load configuration from environment, etc/forge.conf, etc/foreman.conf, and project.conf."""
    conf = {}
    conf.update(load_kv(os.path.join(ROOT, "etc", "forge.conf")))
    conf.update(load_kv(os.path.join(ROOT, "etc", "foreman.conf")))
    p = project or os.environ.get("FORGE_PROJECT")
    if p:
        conf.update(load_kv(os.path.join(ROOT, "projects", p, "project.conf")))
    return conf


def fetch_issues(kind, repo, token, label="agent-forge"):
    """Fetch open issues with the given label from GitHub or GitLab using urllib.request."""
    if kind == "github":
        api_base = os.environ.get("AF_UPSTREAM_API") or "https://api.github.com"
        url = f"{api_base}/repos/{repo}/issues?state=open&labels={urllib.parse.quote(label)}"
        headers = {
            "Authorization": f"Bearer {token}",
            "Accept": "application/vnd.github+json",
            "User-Agent": "agent-forge",
        }
    else:  # gitlab
        api_base = os.environ.get("AF_UPSTREAM_API") or "https://gitlab.com/api/v4"
        pid = urllib.parse.quote(repo, safe="")
        url = f"{api_base}/projects/{pid}/issues?state=opened&labels={urllib.parse.quote(label)}"
        headers = {
            "Authorization": f"Bearer {token}",
            "Accept": "application/json",
            "User-Agent": "agent-forge",
        }

    req = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            raw = resp.read().decode("utf-8")
            data = json.loads(raw)
            if not isinstance(data, list):
                sys.stderr.write(f"Unexpected response from {kind}: expected issue list\n")
                sys.exit(1)
            return data
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            sys.stderr.write(f"Auth error fetching issues from {kind} (HTTP {e.code}): {e.reason}\n")
        else:
            sys.stderr.write(f"HTTP error {e.code} fetching issues from {kind}: {e.reason}\n")
        sys.exit(1)
    except urllib.error.URLError as e:
        sys.stderr.write(f"Network error fetching issues from {kind}: {e.reason}\n")
        sys.exit(1)
    except OSError as e:
        sys.stderr.write(f"Network error fetching issues from {kind}: {e}\n")
        sys.exit(1)
    except (json.JSONDecodeError, UnicodeDecodeError) as e:
        sys.stderr.write(f"Failed to parse JSON issues response from {kind}: {e}\n")
        sys.exit(1)


def validate_issue(issue):
    """Validate issue dictionary structure and reject malformed input cleanly."""
    if not isinstance(issue, dict):
        sys.stderr.write("Malformed payload: issue entry must be a JSON object\n")
        sys.exit(1)

    # Validate id: required, integer or digits-only string
    if "id" not in issue or issue["id"] is None:
        sys.stderr.write("Malformed payload: missing required field 'id'\n")
        sys.exit(1)
    issue_id = issue["id"]
    if isinstance(issue_id, bool) or (not isinstance(issue_id, int) and not (isinstance(issue_id, str) and issue_id.isdigit())):
        sys.stderr.write("Malformed payload: invalid type for 'id': expected integer\n")
        sys.exit(1)

    # Validate title: required, string, non-empty, within size limit
    if "title" not in issue or issue["title"] is None:
        sys.stderr.write("Malformed payload: missing required field 'title'\n")
        sys.exit(1)
    title = issue["title"]
    if not isinstance(title, str):
        sys.stderr.write("Malformed payload: invalid type for 'title': expected string\n")
        sys.exit(1)
    if not title.strip():
        sys.stderr.write("Malformed payload: 'title' cannot be empty\n")
        sys.exit(1)
    if len(title) > MAX_TITLE_LEN:
        sys.stderr.write("Malformed payload: title exceeds maximum allowed length\n")
        sys.exit(1)

    # Validate body: if present, must be string
    body = issue.get("body")
    if body is None:
        body = issue.get("description")
    if body is not None and not isinstance(body, str):
        sys.stderr.write("Malformed payload: invalid type for 'body': expected string\n")
        sys.exit(1)

    # Validate control characters and embedded NUL bytes
    if CONTROL_CHARS_RE.search(title) or (body and CONTROL_CHARS_RE.search(body)):
        sys.stderr.write("Malformed payload: title or body contains invalid control characters or NUL byte\n")
        sys.exit(1)

    # Validate labels: if present, must be a list
    if "labels" in issue and issue["labels"] is not None:
        labels = issue["labels"]
        if not isinstance(labels, list):
            sys.stderr.write("Malformed payload: invalid type for 'labels': expected list\n")
            sys.exit(1)
        for lbl in labels:
            if isinstance(lbl, str):
                continue
            if isinstance(lbl, dict) and (isinstance(lbl.get("name"), str) or isinstance(lbl.get("title"), str)):
                continue
            sys.stderr.write("Malformed payload: invalid label format in 'labels'\n")
            sys.exit(1)


def intake_issues(kind=None, repo=None, token=None, project=None, label="agent-forge", dry_run=False, runs_dir=None):
    """Process issues: queue unseen issues to foreman and track seen IDs."""
    if kind is None or repo is None or token is None:
        conf = get_config(project=project)
        if kind is None:
            kind = os.environ.get("FORGE_KIND") or conf.get("FORGE_KIND")
        if repo is None:
            repo = os.environ.get("FORGE_REPO") or conf.get("FORGE_REPO") or conf.get("UPSTREAM_REPO")
        if token is None:
            token = os.environ.get("FORGE_UPSTREAM_TOKEN") or conf.get("FORGE_UPSTREAM_TOKEN")
            if not token and kind:
                secrets_dir = os.path.expanduser(os.environ.get("SANDBOX_SECRETS") or "~/.config/sandbox/secrets")
                secret_file = os.path.join(secrets_dir, f"{kind}.token")
                if os.path.isfile(secret_file):
                    try:
                        with open(secret_file, "r", encoding="utf-8") as f:
                            token = f.read().strip()
                    except OSError:
                        pass

    # Validate kind
    kind = (kind or "").strip().lower()
    if kind not in ("github", "gitlab"):
        sys.stderr.write(f"Invalid FORGE_KIND {kind!r}: must be 'github' or 'gitlab'\n")
        sys.exit(1)

    # Validate repo
    repo = (repo or "").strip()
    if not repo or not REPO_RE.fullmatch(repo):
        sys.stderr.write(f"Invalid FORGE_REPO {repo!r}: must match owner/repo pattern\n")
        sys.exit(1)

    # Validate project if provided
    if project and not PROJECT_RE.fullmatch(project):
        sys.stderr.write(f"Invalid project name {project!r}\n")
        sys.exit(1)

    # Validate token
    if not token:
        sys.stderr.write(f"Missing upstream token for {kind}: set FORGE_UPSTREAM_TOKEN or secrets/{kind}.token\n")
        sys.exit(1)

    # Determine runs directory and seen path
    if runs_dir is None:
        test_mode = os.environ.get("SANDBOX_TEST") == "1"
        runs_dir = os.environ.get("SANDBOX_RUNS_DIR") if (test_mode and os.environ.get("SANDBOX_RUNS_DIR")) else os.path.join(ROOT, "runs")

    foreman_dir = os.path.join(runs_dir, "projects", project, "foreman") if project else os.path.join(runs_dir, "foreman")
    seen_file = os.path.join(foreman_dir, "issues-intake.json")

    # Load seen file
    seen = []
    if os.path.isfile(seen_file):
        try:
            with open(seen_file, "r", encoding="utf-8") as f:
                d = json.load(f)
                seen = d.get("seen", [])
        except (OSError, json.JSONDecodeError) as e:
            sys.stderr.write(f"Warning: could not read seen file {seen_file}: {e}\n")
            seen = []

    seen_set = set(seen)

    # Fetch issues
    issues = fetch_issues(kind, repo, token, label=label)
    for issue in issues:
        validate_issue(issue)

    # Process issues
    foreman_bin = os.path.join(ROOT, "bin", "foreman")
    for issue in issues:
        issue_id = issue.get("id")
        if issue_id is None:
            continue

        is_seen = (issue_id in seen_set) or (str(issue_id) in seen_set) or (isinstance(issue_id, str) and issue_id.isdigit() and int(issue_id) in seen_set)
        if is_seen:
            continue

        title = issue.get("title", "")
        body = issue.get("body") or issue.get("description") or ""
        goal = build_goal(title, body)

        if dry_run:
            print(f"[dry-run] Would queue issue #{issue.get('number', issue_id)} ({issue_id}): {title}\n{goal}\n")
            continue

        # Call bin/foreman [--project NAME] [--role ROLE] goal - with goal on stdin
        cmd = [foreman_bin]
        if project:
            cmd.extend(["--project", project])
        role = get_issue_role(issue)
        if role:
            cmd.extend(["--role", role])
        cmd.extend(["goal", "-"])

        r = subprocess.run(cmd, input=goal, text=True, errors="replace", capture_output=True)
        if r.returncode != 0:
            sys.stderr.write(f"Failed to queue goal for issue {issue_id}: {r.stderr.strip() or r.stdout.strip()}\n")
            sys.exit(1)

        # Update seen list and persist
        seen.append(issue_id)
        seen_set.add(issue_id)
        os.makedirs(foreman_dir, exist_ok=True)
        with open(seen_file, "w", encoding="utf-8") as f:
            json.dump({"seen": seen}, f, indent=2)

    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(description="Poll GitHub/GitLab issues labelled agent-forge and queue as foreman goals.")
    parser.add_argument("--project", dest="project", default=None, help="Target specific project name")
    parser.add_argument("--label", dest="label", default="agent-forge", help="Issue label filter (default: agent-forge)")
    parser.add_argument("--dry-run", dest="dry_run", action="store_true", help="Print what would be queued without touching state")
    args = parser.parse_args(argv)

    project = args.project or os.environ.get("FORGE_PROJECT")
    return intake_issues(project=project, label=args.label, dry_run=args.dry_run)


if __name__ == "__main__":
    sys.exit(main())
