#!/usr/bin/env python3
"""Agent-Forge's foreman: plans goals into tasks, dispatches them to the workers, gates, reviews and merges their branches.
`bin/foreman --help` lists the commands. The code is the package bin/lib/foreman/ (one module per concern; ARCHITECTURE.md)."""
import os, re, sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib"))


def _early_project():
    """`--project NAME` (anywhere in argv) or FORGE_PROJECT selects a project: its own config (projects/NAME/project.conf),
    repository, worker pool and state (runs/projects/NAME/). Must run before `import sbx`, which reads the environment."""
    a, name = sys.argv, os.environ.get("FORGE_PROJECT", "")
    if "--project" in a:
        i = a.index("--project")
        name = a[i + 1] if i + 1 < len(a) else ""
        del a[i:i + 2]
    if name and not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,39}", name):
        sys.exit(f"invalid project name {name!r} (lowercase letters, digits, dashes)")
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    pdir = os.path.join(root, "projects", name) if name else ""
    if name:
        os.environ["FORGE_PROJECT"] = name
        conf = os.path.join(pdir, "project.conf")
        if os.path.exists(conf):
            for line in open(conf):
                line = line.split("#", 1)[0].strip()
                if line.startswith("FORGE_REPO="):
                    os.environ["FORGE_REPO"] = line.split("=", 1)[1].strip().strip('"')
        elif not (a[1:2] == ["init-project"]):
            sys.exit(f"unknown project {name!r}: projects/{name}/project.conf is missing (bin/foreman init-project {name} --repo org/repo)")
    return name, pdir


_early_project()
from foreman import cli  # noqa: E402  (after the project is chosen: sbx reads it from the environment at import)

if __name__ == "__main__":
    cli.main()
