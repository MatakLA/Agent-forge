#!/usr/bin/env python3
"""Usage: bin/unattended-run <prompt-file> [--label NAME] [--budget USD] [--timeout MIN] [--model ALIAS] [--sources LIST] [--dry-run]
       bin/unattended-run --selftest        built-in tests against a FAKE claude in a scratch dir (kill switch, timeout, refusals, lock; spends nothing)
Runs ONE headless `claude -p` session with the UNATTENDED permission profile (v7/settings.unattended.proposed.json, dontAsk, no prompts possible) and records everything.
The owner starts this by hand (there is no scheduler); the unattended profile itself cannot start it (not in its allow list).

What it does
  * preflight (fails closed): kill switch off, no other unattended run active, `claude` >= 2.1.259, the unattended profile file and the deployed guard hook are byte-identical to the
    approved checksums in v7/SHA256SUMS, prompt file present (<= 20 KB), budget <= 5 USD, timeout <= 30 min, not started from inside an unattended run
  * runs in ~/sandbox:  timeout --kill-after=30 <MIN>m claude -p <prompt> --settings <unattended profile> --setting-sources "" --permission-mode dontAsk
                        --permission-prompts none --output-format stream-json --verbose --max-budget-usd <USD> --model <ALIAS>
    (`--setting-sources ""` = load NO user/project/local settings, so the interactive profile in .claude/settings.local.json cannot widen the unattended allow list: permission lists are UNIONED across scopes)
  * watches the kill switch every 2 s (bin/killswitch on -> SIGTERM to the whole process group, SIGKILL after 30 s)
  * output goes to runs/unattended/<UTC>-<label>/: prompt.md, command.txt, stdout.jsonl (full stream), stderr.log, meta.json, exitcode; a line is appended to runs/unattended/ledger.jsonl;
    nothing is ever deleted or truncated
  * prints a summary: exit code, cost, turns, permission denials (count + list), tool calls by name; alerts (runs/ALERT) on non-zero exit or any denial
Exit code = claude's exit code (124 = timeout wrapper; 143 = terminated by kill switch / SIGTERM); 2 = usage/preflight error; 3 = preflight refused."""
import fcntl, hashlib, json, os, re, signal, subprocess, sys, time
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib"))
import sbx

ROOT = sbx.ROOT
PROFILE = os.path.join(ROOT, "v7", "settings.unattended.proposed.json")
SUMS = os.path.join(ROOT, "v7", "SHA256SUMS")
DEPLOYED_HOOK = os.path.join(ROOT, ".claude", "hooks", "guard.py")
OUT = os.path.join(sbx.RUNS, "unattended")
MAX_BUDGET, DEFAULT_BUDGET, MAX_TIMEOUT, MIN_CLAUDE = 5.0, 2.0, 30.0, (2, 1, 259)
# Test hook (only with SANDBOX_TEST=1, used by --selftest): run a fake claude instead of the real one.
CLAUDE = os.environ["UNATTENDED_CLAUDE_BIN"] if sbx.TEST_MODE and os.environ.get("UNATTENDED_CLAUDE_BIN") else "claude"


def selftest():
    """Runs this wrapper against a FAKE claude in a scratch runs directory: normal run, denials, kill switch, timeout, refusals, lock. Spends nothing."""
    import tempfile
    d = tempfile.mkdtemp(prefix="unattended-selftest-")
    runs = os.path.join(d, "runs")
    os.makedirs(runs)
    fake = os.path.join(d, "claude")
    open(fake, "w").write('''#!/bin/bash
if [ "$1" = "--version" ]; then echo "2.1.274 (Claude Code)"; exit 0; fi
case "$FAKE_MODE" in
  ok)   echo '{"type":"assistant","message":{"content":[{"type":"tool_use","name":"Bash","input":{}}]}}'
        echo '{"type":"result","subtype":"success","is_error":false,"num_turns":3,"total_cost_usd":0.01,"session_id":"fake","result":"done","permission_denials":[]}'; exit 0;;
  deny) echo '{"type":"result","subtype":"success","is_error":false,"num_turns":2,"total_cost_usd":0.02,"session_id":"fake","result":"denied things","permission_denials":[{"tool_name":"Bash","tool_input":{"command":"git push"}},{"tool_name":"Bash","tool_input":{"command":"bin/merge-pr 1"}}]}'; exit 0;;
  sleep) exec sleep 600;;
esac
''')
    os.chmod(fake, 0o755)
    prompt = os.path.join(d, "p.md")
    open(prompt, "w").write("selftest prompt\n")
    base = dict(os.environ, SANDBOX_TEST="1", SANDBOX_RUNS_DIR=runs, UNATTENDED_CLAUDE_BIN=fake)
    bad = 0

    def run(mode, *args, env_extra=None, wait=True):
        env = dict(base, FAKE_MODE=mode, **(env_extra or {}))
        p = subprocess.Popen([sys.executable, os.path.abspath(__file__), prompt, *args], env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        return p if not wait else (p.wait(timeout=60), p.stdout.read(), p.stderr.read())

    def last_meta():
        ds = sorted(x for x in os.listdir(os.path.join(runs, "unattended")) if not x.startswith(".") and os.path.isdir(os.path.join(runs, "unattended", x)))
        return json.load(open(os.path.join(runs, "unattended", ds[-1], "meta.json"))), os.path.join(runs, "unattended", ds[-1])

    def check(name, ok):
        nonlocal bad
        bad += not ok
        print(("ok   " if ok else "FAIL ") + name)

    def group_gone(rundir):
        try:
            os.killpg(int(open(rundir + "/pid").read()), 0)
            return False
        except ProcessLookupError:
            return True
    rc, out, err = run("ok", "--label", "ok")
    m, rd = last_meta()
    check("normal run: exit 0, reason ok, cost/turns parsed, tool calls counted, files written",
          rc == 0 and m["reason"] == "ok" and m["total_cost_usd"] == 0.01 and m["num_turns"] == 3 and m["tool_calls"] == {"Bash": 1} and all(os.path.exists(rd + "/" + f) for f in ("prompt.md", "command.txt", "stdout.jsonl", "stderr.log", "meta.json", "exitcode", "finished")))
    check("command.txt records the profile, empty --setting-sources, dontAsk, --permission-prompts none, budget, timeout wrapper",
          all(x in open(rd + "/command.txt").read() for x in ("--settings", '--setting-sources ""', "--permission-mode dontAsk", "--permission-prompts none", "--max-budget-usd 2", "timeout --signal=TERM --kill-after=30 1800s")))
    rc, out, err = run("deny", "--label", "deny")
    m, rd = last_meta()
    check("denials are counted, listed and printed; ALERT written", rc == 0 and len(m["permission_denials"]) == 2 and "DENIED Bash" in out and "permission denial(s)" in open(os.path.join(runs, "ALERT")).read())
    check("ledger has both runs", len(open(os.path.join(runs, "unattended", "ledger.jsonl")).read().splitlines()) == 2)
    p = run("sleep", "--label", "ks", "--timeout", "5", wait=False)
    time.sleep(4)
    open(os.path.join(runs, "KILLSWITCH"), "w").write(json.dumps(dict(at=sbx.now(), reason="selftest", by="selftest")))
    try:
        rc = p.wait(timeout=30)
    except subprocess.TimeoutExpired:
        p.kill(); rc = None
    m, rd = last_meta()
    check("kill switch stops a running session (reason killswitch, process group gone, exit != 0)", rc not in (None, 0) and m["reason"] == "killswitch" and group_gone(rd))
    rc, out, err = run("ok", "--label", "refused")
    check("kill switch ON refuses to start (exit 3)", rc == 3 and "kill switch is ON" in err)
    os.remove(os.path.join(runs, "KILLSWITCH"))
    rc, out, err = run("sleep", "--label", "to", "--timeout", "0.05")
    m, rd = last_meta()
    check("timeout wrapper ends a hanging session (exit 124, reason timeout, process group gone)", rc == 124 and m["reason"] == "timeout" and group_gone(rd))
    p1 = run("sleep", "--label", "lock1", "--timeout", "0.2", wait=False)
    time.sleep(3)
    rc, out, err = run("ok", "--label", "lock2")
    check("a second unattended run is refused while one is active (exit 3)", rc == 3 and "another unattended run is active" in err)
    p1.wait(timeout=90)
    for name, args, env_extra, want, needle in (("budget above the cap", ("--budget", "9"), None, 2, "budget"), ("timeout above the cap", ("--timeout", "31"), None, 2, "timeout"),
                                                ("recursion (started from an unattended run)", (), {"SANDBOX_UNATTENDED": "1"}, 3, "recursion")):
        rc, out, err = run("ok", "--label", "x", *args, env_extra=env_extra)
        check(f"refused: {name}", rc == want and needle in err)
    rc = subprocess.run([sys.executable, os.path.abspath(__file__), os.path.join(d, "missing.md")], env=base, capture_output=True, text=True).returncode
    check("refused: prompt file missing (exit 2)", rc == 2)
    n_before = len(os.listdir(os.path.join(runs, "unattended")))
    rc, out, err = run("ok", "--label", "dry", "--dry-run")
    check("--dry-run prints the command and creates no run directory", rc == 0 and "preflight OK" in out and len(os.listdir(os.path.join(runs, "unattended"))) == n_before)
    print("unattended-run selftest: " + ("ALL OK" if not bad else f"{bad} FAILED") + f"   (scratch dir {d}, nothing spent)")
    return 1 if bad else 0


def refuse(msg, code=3):
    print(f"REFUSED: {msg}", file=sys.stderr)
    sys.exit(code)


def sha(p):
    return hashlib.sha256(open(p, "rb").read()).hexdigest()


a = sys.argv[1:]
if a[:1] == ["--selftest"]:
    sys.exit(selftest())
if not a or a[0].startswith("-") or a[0] in ("-h", "--help"):
    print(__doc__, file=sys.stderr); sys.exit(2)
opt = lambda n, d=None: a[a.index(n) + 1] if n in a and a.index(n) + 1 < len(a) else d
prompt_file, label = a[0], re.sub(r"[^A-Za-z0-9_-]", "", opt("--label", "run"))[:40] or "run"
budget, minutes, model, sources = float(opt("--budget", DEFAULT_BUDGET)), float(opt("--timeout", MAX_TIMEOUT)), opt("--model", "sonnet"), opt("--sources", "")
dry = "--dry-run" in a
if os.environ.get("SANDBOX_UNATTENDED"):
    refuse("started from inside an unattended run (recursion is not allowed)")
if not os.path.isfile(prompt_file) or os.path.getsize(prompt_file) > 20000:
    refuse("prompt file missing or larger than 20 KB", 2)
if not (0 < budget <= MAX_BUDGET):
    refuse(f"budget must be > 0 and <= {MAX_BUDGET} USD", 2)
if not (0 < minutes <= MAX_TIMEOUT):
    refuse(f"timeout must be > 0 and <= {MAX_TIMEOUT:g} minutes", 2)
ks = sbx.killswitch_active()
if ks:
    refuse(f"kill switch is ON since {ks.get('at')} ({ks.get('reason')})")
ver = subprocess.run([CLAUDE, "--version"], capture_output=True, text=True).stdout.split()
try:
    vt = tuple(int(x) for x in ver[0].split("."))
except Exception:
    refuse("cannot read the claude version")
if vt < MIN_CLAUDE:
    refuse(f"claude {ver[0]} is older than 2.1.259 (--permission-prompts needs it)")
sums = dict(reversed(l.split()) for l in open(SUMS).read().splitlines() if l.strip())
if sha(PROFILE) != sums.get("settings.unattended.proposed.json"):
    refuse("v7/settings.unattended.proposed.json differs from the approved checksum in v7/SHA256SUMS")
if not os.path.isfile(DEPLOYED_HOOK) or sha(DEPLOYED_HOOK) != sums.get("hooks/guard.py"):
    refuse("the deployed guard hook is missing or differs from the approved checksum (run python3 v7/verify-deploy.py)")
os.makedirs(OUT, exist_ok=True)
lockf = open(os.path.join(OUT, ".lock"), "w")
try:
    fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError:
    refuse("another unattended run is active")
prompt = open(prompt_file).read()
argv = ["timeout", "--signal=TERM", "--kill-after=30", f"{int(minutes * 60)}s", CLAUDE, "-p", prompt, "--settings", PROFILE, "--setting-sources", sources,
        "--permission-mode", "dontAsk", "--permission-prompts", "none", "--output-format", "stream-json", "--verbose", "--max-budget-usd", f"{budget:g}", "--model", model]
shown = [x if x != prompt else f"<contents of {prompt_file}>" for x in argv]
if dry:
    print("preflight OK. Would run in " + ROOT + ":\n  " + " ".join(f'"{x}"' if (x == "" or " " in x) else x for x in shown))
    sys.exit(0)
run = os.path.join(OUT, f"{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())}-{label}")
os.makedirs(run)
open(run + "/prompt.md", "w").write(prompt)
open(run + "/command.txt", "w").write(" ".join(f'"{x}"' if (x == "" or " " in x) else x for x in shown) + "\n")
t0 = time.time()
open(run + "/started", "w").write(sbx.now() + "\n")
env = dict(os.environ, SANDBOX_UNATTENDED="1")
proc = subprocess.Popen(argv, cwd=ROOT, stdin=subprocess.DEVNULL, stdout=open(run + "/stdout.jsonl", "w"), stderr=open(run + "/stderr.log", "w"), env=env, start_new_session=True)
open(run + "/pid", "w").write(str(proc.pid))
print(f"unattended run started: {run}  (pid {proc.pid}, budget {budget:g} USD, timeout {minutes:g} min, model {model}); stop with: bin/killswitch on", flush=True)
reason = None
while proc.poll() is None:
    time.sleep(2)
    if reason is None and sbx.killswitch_active():
        reason = "killswitch"
        os.killpg(proc.pid, signal.SIGTERM)
        deadline = time.time() + 30
        while proc.poll() is None and time.time() < deadline:
            time.sleep(1)
        if proc.poll() is None:
            os.killpg(proc.pid, signal.SIGKILL)
rc = proc.wait()
if rc < 0:
    rc = 128 - rc      # killed by a signal -> shell convention (SIGTERM = 143)
dur = int(time.time() - t0)
res, denied_events, tools = None, 0, {}
denials = []
for line in open(run + "/stdout.jsonl"):
    try:
        e = json.loads(line)
    except Exception:
        continue
    if e.get("type") == "result":
        res = e
    if e.get("type") == "system" and "denied" in str(e.get("subtype", "")):
        denied_events += 1
    if e.get("type") == "assistant":
        for c in (e.get("message") or {}).get("content") or []:
            if isinstance(c, dict) and c.get("type") == "tool_use":
                tools[c.get("name")] = tools.get(c.get("name"), 0) + 1
if res:
    for d in res.get("permission_denials") or []:
        denials.append(dict(tool=d.get("tool_name"), input=str(d.get("tool_input"))[:200]))
summary = dict(exit_code=rc, reason=reason or ("timeout" if rc == 124 else "ok" if rc == 0 else "nonzero-exit"), duration_s=dur, is_error=(res or {}).get("is_error"),
               subtype=(res or {}).get("subtype"), num_turns=(res or {}).get("num_turns"), total_cost_usd=(res or {}).get("total_cost_usd"), session_id=(res or {}).get("session_id"),
               permission_denials=denials, denied_system_events=denied_events, tool_calls=tools, result_text=str((res or {}).get("result", ""))[:1500], budget_usd=budget, model=model)
summary.update(run=os.path.basename(run), label=label, started=open(run + "/started").read().strip(), finished=sbx.now())
json.dump(summary, open(run + "/meta.json", "w"), indent=1)
with open(os.path.join(OUT, "ledger.jsonl"), "a") as f:
    fcntl.flock(f, fcntl.LOCK_EX)
    f.write(json.dumps({k: summary[k] for k in ("run", "label", "started", "finished", "exit_code", "reason", "duration_s", "total_cost_usd", "num_turns")} | dict(denials=len(denials)), separators=(",", ":")) + "\n")
if rc != 0 or denials or reason:
    sbx.alert(f"unattended run {os.path.basename(run)}: exit {rc}, reason {summary['reason']}, {len(denials)} permission denial(s), cost {summary['total_cost_usd']}")
open(run + "/exitcode", "w").write(f"{rc}\n")
open(run + "/finished", "w").write(sbx.now() + "\n")
print(f"finished: exit {rc} ({summary['reason']}), {dur}s, cost {summary['total_cost_usd']} USD, turns {summary['num_turns']}, tool calls {tools}")
print(f"permission denials: {len(denials)}" + ("".join(f"\n  DENIED {d['tool']}: {d['input']}" for d in denials)))
print("result: " + summary["result_text"][:600].replace("\n", " "))
print(f"details: {run}/meta.json, {run}/stdout.jsonl")
sys.exit(rc)
