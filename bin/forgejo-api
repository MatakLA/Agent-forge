#!/usr/bin/env python3
"""Usage: bin/forgejo-api GET /repos/sandbox/playground/pulls?state=all     (read-only Forgejo API access with the monitoring token)
Only GET, only paths under /repos/sandbox/playground, /orgs/sandbox or /users/worker-N. Writes have dedicated wrappers (open-pr, merge-pr)."""
import json, os, re, sys, urllib.request
a = sys.argv[1:]
if len(a) != 2 or a[0].upper() != "GET" or not re.match(r"^/(repos/sandbox/playground|orgs/sandbox|users/worker-\d+)(/|\?|$)", a[1]) or ".." in a[1]:
    print(__doc__, file=sys.stderr); sys.exit(2)
tok = open(os.path.expanduser("~/.config/sandbox/secrets/monitor.token")).read().strip()
req = urllib.request.Request("http://127.0.0.1:3000/api/v1" + a[1], headers={"Authorization": "token " + tok})
try:
    with urllib.request.urlopen(req, timeout=20) as r:
        print(r.read().decode())
except urllib.error.HTTPError as e:
    print(f"HTTP {e.code}: {e.read().decode()[:300]}", file=sys.stderr); sys.exit(1)
