#!/usr/bin/env python3
"""Usage: printf '%s' "<value>" | bin/secret-set <name>      store a secret (read from stdin) in the secrets directory
       bin/secret-set --list                                 which known secrets exist (names only, never values)

Only these names are accepted: anthropic.key, openai.key, gemini.key, compat.key (API keys for worker runtimes; compat.key is
for your own model server, if it wants one), github.token, gitlab.token (the upstream forge), notify.token (notifications).
The value is read from stdin - never from the command line, which other local users can read in /proc - and written with mode
0600 into ~/.config/sandbox/secrets (0700). Nothing about the value is printed. Used by the dashboard's setup and add-worker dialogs."""
import os, re, sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib"))
import sbx

NAMES = ("anthropic.key", "openai.key", "gemini.key", "compat.key", "github.token", "gitlab.token", "notify.token")
a = sys.argv[1:]
if a == ["--list"]:
    for n in NAMES:
        p = os.path.join(sbx.SECRETS, n)
        print(f"{n} {'set' if os.path.exists(p) and os.path.getsize(p) else 'missing'}")
    sys.exit(0)
if len(a) != 1 or a[0] not in NAMES:
    print(__doc__, file=sys.stderr); sys.exit(2)
value = sys.stdin.read().strip()
if not value or len(value) > 4096 or re.search(r"\s", value):
    print("refused: the value must be one non-empty token without spaces or newlines", file=sys.stderr); sys.exit(2)
os.makedirs(sbx.SECRETS, mode=0o700, exist_ok=True)
os.chmod(sbx.SECRETS, 0o700)
p = os.path.join(sbx.SECRETS, a[0])
tmp = p + ".tmp"
try:
    os.unlink(tmp)
except FileNotFoundError:
    pass
flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC
if hasattr(os, "O_NOFOLLOW"):
    flags |= os.O_NOFOLLOW
fd = os.open(tmp, flags, 0o600)
try:
    os.fchmod(fd, 0o600)
    os.write(fd, value.encode())
finally:
    os.close(fd)
os.replace(tmp, p)
os.chmod(p, 0o600)
print(f"stored {a[0]} ({len(value)} characters)")

