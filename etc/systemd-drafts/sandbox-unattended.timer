# DRAFT - NOT INSTALLED, NOT ENABLED (see sandbox-unattended.service for the prerequisites).
[Unit]
Description=Sandbox unattended orchestrator run, at most once a day (DRAFT)

[Timer]
# Example only: once a day at 03:30 UTC. Persistent=false: a missed run is NOT caught up after a reboot/suspend.
OnCalendar=*-*-* 03:30:00 UTC
Persistent=false
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
