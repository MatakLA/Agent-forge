# DRAFT - NOT INSTALLED, NOT ENABLED. Design only (owner decision of 2026-09-26: scheduling stays a draft).
# Would run ONE bounded unattended orchestrator session (bin/unattended-run, profile dontAsk) from a user timer.
# Prerequisites before anyone enables it (all owner decisions): read v7/UNATTENDED.md; a reviewed prompt file (tasks/unattended-daily-prompt.md does NOT exist);
# a task file with acceptance criteria; the checks from the runbook (bin/status OK, verify-deploy ALL CHECKS PASSED); the kill switch procedure understood.
# Never schedule bin/dispatch directly, never add --bare / bypass flags, never raise the caps in the wrapper.
[Unit]
Description=Sandbox unattended orchestrator run (DRAFT, bounded: budget and timeout caps)
# The kill switch flag file blocks the start; bin/unattended-run also refuses itself while the kill switch is on.
ConditionPathExists=!%h/sandbox/runs/KILLSWITCH

[Service]
Type=oneshot
WorkingDirectory=%h/sandbox
ExecStart=%h/sandbox/bin/unattended-run tasks/unattended-daily-prompt.md --label daily --budget 2.0 --timeout 30
# 30 min session timeout + kill-after + margin
TimeoutStartSec=2100
