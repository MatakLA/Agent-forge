[Unit]
Description=Sandbox foreman: plans, dispatches, gates, reviews and merges worker tasks on its own
After=docker.service network-online.target
Wants=docker.service

[Service]
User=dev
WorkingDirectory=/home/dev/sandbox
Environment=HOME=/home/dev PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/dev/sandbox/bin/foreman run
Restart=always
RestartSec=30
KillMode=process

[Install]
WantedBy=multi-user.target
